            "source": [
                "def load_all_feats_df(type: Type, **kwargs):\n",
                '    return pd.concat([pd.read_parquet(filepath, **kwargs) for filepath in Path("../artifacts/feats").rglob(f"{type}_feats.parquet")])\n',
